{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invaris.dev/schemas/harness-v1alpha3.schema.json",
  "title": "Invaris mutation harness v1alpha3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "trustMode",
    "networkPolicy",
    "writablePaths",
    "experiment"
  ],
  "properties": {
    "version": {
      "const": "invaris.dev/v1alpha3"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "trustMode": {
      "const": "trusted-local"
    },
    "networkPolicy": {
      "const": "unrestricted"
    },
    "writablePaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      },
      "minItems": 1
    },
    "redactEnv": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/envName"
      }
    },
    "storeSensitiveOutput": {
      "type": "boolean",
      "default": false
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mutation",
        "validation",
        "test",
        "testIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/label"
        },
        "mutation": {
          "$ref": "#/$defs/replacement"
        },
        "validation": {
          "$ref": "#/$defs/command"
        },
        "test": {
          "$ref": "#/$defs/command"
        },
        "testIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/label"
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\\\:\\u0000])(?:[^/]+/)*[^/]+$",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)"
      }
    },
    "envName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^=\\u0000]+$"
    },
    "timeout": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "program"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "program": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "envAllowlist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envName"
          }
        },
        "timeoutSeconds": {
          "$ref": "#/$defs/timeout"
        }
      }
    },
    "label": {
      "type": "string",
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operator",
        "path",
        "before",
        "after"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/label"
        },
        "operator": {
          "const": "replace"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "before": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
