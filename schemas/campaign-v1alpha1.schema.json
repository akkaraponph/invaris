{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invaris.dev/schemas/campaign-v1alpha1.schema.json",
  "title": "Invaris campaign v1alpha1",
  "description": "A sequential campaign over existing harnesses in the same directory. Go validation additionally loads every referenced harness, checks that the referenced experiment or challenge exists with the right harness version and a structured guard, rejects duplicate references, and checks that enabled requirements apply to at least one declared experiment kind.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "trustMode", "networkPolicy", "experiments", "acceptance"],
  "properties": {
    "version": {"const": "invaris.campaign/v1alpha1"},
    "name": {"type": "string", "pattern": "\\S"},
    "trustMode": {"const": "trusted-local"},
    "networkPolicy": {"const": "unrestricted"},
    "experiments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/experiment"}
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireNoSurvivors", "requireAllGuardrailsProven", "requireNoInconclusive", "requireNoMixed"],
      "properties": {
        "requireNoSurvivors": {"type": "boolean"},
        "requireAllGuardrailsProven": {"type": "boolean"},
        "requireNoInconclusive": {"type": "boolean"},
        "requireNoMixed": {"type": "boolean"},
        "requireNoInvalid": {"type": "boolean"},
        "minMutationScore": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "harness", "repeat"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["mutation", "guardrail"]},
        "harness": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\:\\u0000]+$", "not": {"enum": [".", ".."]}},
        "experimentId": {"type": "string", "minLength": 1},
        "challengeId": {"type": "string", "minLength": 1},
        "repeat": {"type": "integer", "minimum": 1, "maximum": 5}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "mutation"}}, "required": ["experimentId"], "not": {"required": ["challengeId"]}},
        {"properties": {"kind": {"const": "guardrail"}}, "required": ["challengeId"], "not": {"required": ["experimentId"]}}
      ]
    }
  }
}
