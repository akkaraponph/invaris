{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akkaraponph/invaris/schemas/harness-v1alpha4.schema.json",
  "title": "Invaris harness v1alpha4",
  "description": "Guard harness: v1alpha2 plus built-in challenge mutations. A challenge has either before/after (literal) or mutation (built-in), never both. The Go loader also enforces ID uniqueness, gate references, writable targets, structured guards for built-ins and size limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "trustMode",
    "networkPolicy"
  ],
  "properties": {
    "version": {
      "const": "invaris.dev/v1alpha4"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "trustMode": {
      "const": "trusted-local"
    },
    "networkPolicy": {
      "const": "unrestricted"
    },
    "writablePaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "failFast": {
      "type": "boolean"
    },
    "alwaysRunGuards": {
      "type": "boolean"
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "gate": {
      "$ref": "#/$defs/gate"
    },
    "redactEnv": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/envName"
      }
    },
    "storeSensitiveOutput": {
      "type": "boolean",
      "default": false
    },
    "adapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adapter"
      }
    },
    "requiredAdapters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "guards": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/commandGuard"
          },
          {
            "$ref": "#/$defs/providerGuard"
          }
        ]
      }
    },
    "challenges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/challenge"
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "description": "Narrows the disposable workspace copy. Paths are relative to the harness directory.",
      "properties": {
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "description": "Paths neither copied nor compared between stages, such as build output and tool caches."
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^/\\\\:\\u0000]+$",
            "not": {
              "enum": [
                ".",
                "..",
                ".git",
                ".invaris"
              ]
            }
          },
          "description": "Top-level directories, such as node_modules, linked beside the workspace instead of copied."
        },
        "maxEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000,
          "description": "Entry bound for the copy and its snapshots. Defaults to 2000."
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\\\:\\u0000])(?:[^/]+/)*[^/]+$",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)"
      }
    },
    "envName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^=\\u0000]+$"
    },
    "timeout": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "allowEmpty": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredGuards": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredProofs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "precedence": {
          "enum": [
            "failure-first",
            "refusal-first"
          ],
          "default": "failure-first"
        },
        "allowWeakEvidence": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "program"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "program": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "envAllowlist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envName"
          }
        },
        "timeoutSeconds": {
          "$ref": "#/$defs/timeout"
        },
        "minInspected": {
          "type": "integer",
          "minimum": 1
        },
        "policyId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "commandGuard": {
      "$ref": "#/$defs/command"
    },
    "providerGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapterId",
        "policyId",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "adapterId": {
          "type": "string",
          "minLength": 1
        },
        "policyId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "const": "."
              },
              {
                "$ref": "#/$defs/relativePath"
              }
            ]
          }
        },
        "options": {
          "description": "Opaque provider options, validated by the provider."
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "program"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "program": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "envAllowlist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envName"
          }
        },
        "timeoutSeconds": {
          "$ref": "#/$defs/timeout"
        }
      }
    },
    "challenge": {
      "oneOf": [
        {
          "$ref": "#/$defs/literalChallenge"
        },
        {
          "$ref": "#/$defs/builtinChallenge"
        }
      ]
    },
    "literalChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "guard",
        "file",
        "before",
        "after"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "guard": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "$ref": "#/$defs/relativePath"
        },
        "before": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        },
        "expectedOutput": {
          "type": "string"
        }
      }
    },
    "builtinChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "guard",
        "file",
        "mutation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "guard": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "$ref": "#/$defs/relativePath"
        },
        "mutation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "version",
            "preimageSha256"
          ],
          "properties": {
            "operator": {
              "enum": [
                "trailing-whitespace",
                "crlf-injection",
                "secret-leak-injection"
              ]
            },
            "version": {
              "const": "1"
            },
            "preimageSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "fixture": {
              "const": "invaris-test-token-v1"
            }
          },
          "if": {
            "properties": {
              "operator": {
                "const": "secret-leak-injection"
              }
            }
          },
          "then": {
            "required": [
              "fixture"
            ]
          },
          "else": {
            "not": {
              "required": [
                "fixture"
              ]
            }
          }
        }
      }
    }
  }
}
