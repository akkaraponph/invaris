{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invaris.dev/schemas/harness-v1alpha2.schema.json",
  "title": "Invaris harness v1alpha2",
  "description": "Structure of an invaris.dev/v1alpha2 harness. Cross-field rules (unique IDs, gate references, path safety, 128-task limit, 1 MiB size, duplicate-key rejection) are enforced by the Go loader; provider adapters and provider guards are declared here but are refused at run time until negotiated providers are executable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "trustMode", "networkPolicy"],
  "properties": {
    "version": {"const": "invaris.dev/v1alpha2"},
    "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "trustMode": {"const": "trusted-local"},
    "networkPolicy": {"const": "unrestricted"},
    "writablePaths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
    "failFast": {"type": "boolean"},
    "alwaysRunGuards": {"type": "boolean"},
    "policies": {"type": "array", "items": {"$ref": "#/$defs/policy"}},
    "gate": {"$ref": "#/$defs/gate"},
    "redactEnv": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/envName"}},
    "storeSensitiveOutput": {"type": "boolean", "default": false},
    "adapters": {"type": "array", "items": {"$ref": "#/$defs/adapter"}},
    "requiredAdapters": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/command"}},
    "guards": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/commandGuard"}, {"$ref": "#/$defs/providerGuard"}]}},
    "challenges": {"type": "array", "items": {"$ref": "#/$defs/challenge"}}
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*[\\\\:\\u0000])(?:[^/]+/)*[^/]+$", "not": {"pattern": "(^|/)\\.{1,2}(/|$)"}},
    "envName": {"type": "string", "minLength": 1, "pattern": "^[^=\\u0000]+$"},
    "timeout": {"type": "integer", "minimum": 0, "maximum": 300},
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}, "allowEmpty": {"type": "boolean", "default": false}}
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "requiredGuards": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "requiredProofs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "precedence": {"enum": ["failure-first", "refusal-first"], "default": "failure-first"},
        "allowWeakEvidence": {"type": "boolean", "default": false}
      }
    },
    "command": {
      "type": "object", "additionalProperties": false, "required": ["id", "program"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "program": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}},
        "envAllowlist": {"type": "array", "items": {"$ref": "#/$defs/envName"}},
        "timeoutSeconds": {"$ref": "#/$defs/timeout"},
        "minInspected": {"type": "integer", "minimum": 1},
        "policyId": {"type": "string", "minLength": 1}
      }
    },
    "commandGuard": {"$ref": "#/$defs/command"},
    "providerGuard": {
      "type": "object", "additionalProperties": false, "required": ["id", "adapterId", "policyId", "scope"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "adapterId": {"type": "string", "minLength": 1},
        "policyId": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "items": {"oneOf": [{"const": "."}, {"$ref": "#/$defs/relativePath"}]}},
        "options": {"description": "Opaque provider options, validated by the provider."}
      }
    },
    "adapter": {
      "type": "object", "additionalProperties": false, "required": ["id", "program"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "program": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}},
        "envAllowlist": {"type": "array", "items": {"$ref": "#/$defs/envName"}},
        "timeoutSeconds": {"$ref": "#/$defs/timeout"}
      }
    },
    "challenge": {
      "type": "object", "additionalProperties": false, "required": ["id", "guard", "file", "before", "after"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "guard": {"type": "string", "minLength": 1},
        "file": {"$ref": "#/$defs/relativePath"},
        "before": {"type": "string", "minLength": 1},
        "after": {"type": "string", "minLength": 1},
        "expectedOutput": {"type": "string"}
      }
    }
  }
}
