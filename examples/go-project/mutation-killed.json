{
  "version": "invaris.dev/v1alpha3",
  "name": "go-project",
  "trustMode": "trusted-local",
  "networkPolicy": "unrestricted",
  "writablePaths": [
    "internal/discount/discount.go"
  ],
  "experiment": {
    "id": "go-mutation-killed",
    "mutation": {
      "id": "percent-divisor",
      "operator": "replace",
      "path": "internal/discount/discount.go",
      "before": "cents*percent/100",
      "after": "cents*percent/10",
      "preimageSha256": "5e1cc1dbbdeb114fa42be3cdf3b855d682e721b2d7c04368c9627fcb31a49718"
    },
    "validation": {
      "id": "build",
      "program": "go",
      "args": [
        "run",
        "./tools/goeval",
        "validity"
      ],
      "envAllowlist": [
        "PATH",
        "HOME"
      ],
      "timeoutSeconds": 120
    },
    "test": {
      "id": "go-tests",
      "program": "go",
      "args": [
        "run",
        "./tools/goeval",
        "tests",
        "TestFullPrice",
        "TestHalfOff"
      ],
      "envAllowlist": [
        "PATH",
        "HOME"
      ],
      "timeoutSeconds": 120
    },
    "testIds": [
      "TestFullPrice",
      "TestHalfOff"
    ]
  }
}
