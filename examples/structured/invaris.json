{
  "version": "invaris.dev/v1alpha1",
  "name": "structured fixture",
  "guards": [{
    "id": "fixture-guard",
    "policyId": "no-forbidden-marker",
    "program": "sh",
    "args": ["guard.sh"]
  }],
  "challenges": [{
    "id": "detect-marker",
    "guard": "fixture-guard",
    "file": "source.txt",
    "before": "SAFE",
    "after": "FORBIDDEN"
  }]
}
