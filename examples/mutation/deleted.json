{
  "version": "invaris.dev/v1alpha3",
  "name": "mutation-fixture",
  "trustMode": "trusted-local",
  "networkPolicy": "unrestricted",
  "writablePaths": [
    "behavior.sh"
  ],
  "experiment": {
    "id": "mutation-deleted",
    "mutation": {
      "id": "delete-killed",
      "operator": "delete",
      "path": "behavior.sh",
      "before": " 'covered-original'"
    },
    "validation": {
      "id": "syntax",
      "program": "sh",
      "args": [
        "validate.sh"
      ]
    },
    "test": {
      "id": "assert-covered",
      "program": "sh",
      "args": [
        "test.sh"
      ]
    },
    "testIds": [
      "covered"
    ]
  }
}
